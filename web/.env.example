NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exactly "true" enables the local demo (also on when Supabase env is missing).
# Any other value runs the real Supabase-backed app.
NEXT_PUBLIC_DEMO_MODE=true
SUPABASE_PHOTOS_BUCKET=journal-photos
SUPABASE_THUMBNAILS_BUCKET=journal-thumbnails
# Web Push reminders. Generate the key pair with: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services may use, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Shared secret for /api/push/dispatch. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" once the env var is set in Vercel.
CRON_SECRET=
